{
  "name": "radoslaw-rojek-resport-www",
  "version": "1.0.0",
  "description": "Webpage for Radosław Rojek physiotherapist",
  "main": "\u001b[D\u001b[D\u001b[C\u001b[Cindex.html",
  "scripts": {
    "clean": "rimraf dist",
    "scss": "sass src/scss/main.scss dist/css/style.css",
    "prefix": "postcss dist/css/style.css --use=autoprefixer --map=false --output=dist/css/style.css",
    "cssmin": "npx cleancss -o dist/css/style.css dist/css/style.css",
    "babel": "babel src/js --out-dir dist/js --copy-files",
    "jsmin": "terser dist/js/script.js --compress --mangle --output dist/js/script.js",
    "cp:html": "cpx 'src/**/*.html' dist",
    "cp:php": "cpx 'src/**/*.php' dist",
    "cp:img": "cpx 'src/img/**/*' dist/img",
    "cp:vendor": "cpx 'src/vendor/**/*' dist/vendor",
    "cp": "npm run cp:html && npm run cp:php && npm run cp:img && npm run cp:vendor",
    "build:css": "npm run scss && npm run prefix && npm run cssmin",
    "build:js": "mkdirp dist/js && npm run babel && npm run jsmin",
    "build": "npm run clean && npm run build:css && npm run build:js && npm run cp && echo Finished successfully!",
    "watch:css": "sass --watch src/scss/main.scss:dist/css/style.css",
    "live": "cd src && npx live-server --browser=chrome --mount=/css:../dist/css",
    "dev": "npm-run-all --parallel watch:css live"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awysocka/radoslaw-rojek-resport-www.git"
  },
  "author": "Anna Wysocka",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/awysocka/radoslaw-rojek-resport-www/issues"
  },
  "homepage": "https://github.com/awysocka/radoslaw-rojek-resport-www#readme",
  "devDependencies": {
    "@babel/cli": "^7.6.0",
    "@babel/core": "^7.6.0",
    "@babel/preset-env": "^7.6.0",
    "autoprefixer": "^10.4.24",
    "clean-css-cli": "^4.3.0",
    "concurrently": "^9.2.1",
    "cpx": "^1.5.0",
    "live-server": "^1.2.2",
    "mkdirp": "^0.5.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-cli": "^9.1.0",
    "sass": "^1.73.1",
    "terser": "^4.1.3"
  },
  "browserslist": [
    "last 2 versions"
  ]
}
